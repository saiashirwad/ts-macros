{
  "name": "ts-macros",
  "module": "src/index.ts",
  "type": "module",
  "scripts": {
    "format": "prettier --write ."
  },
  "prettier": {
    "printWidth": 80,
    "useTabs": false,
    "semi": true,
    "trailingComma": "all",
    "experimentalTernaries": true,
    "arrowParens": "avoid",
    "proseWrap": "always"
  },
  "devDependencies": {
    "@types/babel__core": "^7.20.5",
    "@types/babel__generator": "^7.27.0",
    "@types/bun": "latest",
    "typescript": "^7.0.2",
    "prettier": "^3.6.2"
  },
  "dependencies": {
    "@babel/generator": "^7.23.0",
    "@babel/types": "^7.23.0"
  }
}
